{
  "ai": {
    "localAssist": true
  },
  "$schema": "../socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "capabilities": {
    "cpp": ["src/sockeye"]
  },
  "cover": {
    "cumulativeCoverageThreshold": 99.5
  },
  "repoName": "sockeye",
  "repo": { "type": "solo" },
  "build": {
    "from": "github-release",
    "type": "binary"
  },
  "fuzz": {
    "exempt": true,
    "reason": "The untrusted-input boundary is the native C++ core (input-policy request parsing), fuzzed via the libFuzzer harness at test/repo/fuzz/native/input-policy-fuzz.cc (pnpm run fuzz). The JS/TS surface is fleet tooling and the vitest harness around the binary — no first-party JS parser boundary for a vitiate lane to exercise."
  },
  "release": {
    "github": false,
    "versionSource": "package.json"
  },
  "vitest": {
    "lanes": {
      "fast": ["test/fleet/**", "test/repo/unit/**"],
      "mid": [
        "test/repo/unit/agent-ci.test.mts",
        "test/repo/unit/build-toolchain.test.mts",
        "test/repo/unit/cover-cpp-phases.test.mts",
        "test/repo/unit/fetch-session.test.mts",
        "test/repo/unit/keychain-evidence-is-complete.test.mts",
        "test/repo/unit/native-coverage.test.mts",
        "test/repo/unit/native-security-tests-are-wired.test.mts",
        "test/repo/unit/native-toolchain.test.mts",
        "test/repo/unit/one-password-metadata.test.mts",
        "test/repo/unit/optimize-svg.test.mts",
        "test/repo/unit/request-preview-is-isolated.test.mts",
        "test/repo/unit/setup-credential-authorization.test.mts",
        "test/repo/unit/setup-credential/references.test.mts"
      ],
      "slow": [
        "**/test/**/integration/**",
        "**/test/**/e2e/**",
        "test/repo/unit/build.test.mts",
        "test/repo/unit/fuzz.test.mts",
        "test/repo/unit/notarize.test.mts",
        "test/repo/unit/setup-credential.test.mts",
        "test/repo/unit/setup-sockeye.test.mts",
        "test/repo/unit/sign.test.mts",
        "test/repo/unit/test.test.mts",
        "test/repo/unit/verify-release.test.mts"
      ]
    }
  }
}
